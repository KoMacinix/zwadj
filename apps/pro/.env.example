# URL de l'API NestJS (préfixe /api/v1 géré par le client HTTP)
VITE_API_URL=http://localhost:3001

# URL publique du site Client (liens CGU/confidentialité depuis le pro)
VITE_CLIENT_URL=http://localhost:3000

# Fond de carte (les « tuiles ») — session « carte ». TROIS variables, aucune valeur réelle ici.
# ⚠ EN PRODUCTION, SANS LES DEUX PREMIÈRES, la carte du formulaire de salle ne s'offre pas (« carte indisponible ») : le
# défaut OpenStreetMap ne sert qu'en développement. Mêmes valeurs que les NEXT_PUBLIC_MAP_TILES_* du site client.
# Gabarit d'adresse des tuiles, en https, avec {z} {x} {y} — format : https://<hôte>/{z}/{x}/{y}.png
# VITE_MAP_TILES_URL=
# Mention d'attribution exigée par le fournisseur — format : © Nom du fournisseur
# VITE_MAP_TILES_ATTRIBUTION=
# Lien de la mention (page de licence), en https — facultatif
# VITE_MAP_TILES_ATTRIBUTION_URL=
