// =============================================================================
// ZWADJ — schema.prisma (MVP)
// =============================================================================
// Traduit les décisions produit d'AGENTS.md + la Phase 3 de ZWADJ_BACKLOG(1).md.
// Chaque modèle référence en commentaire sa section de backlog (ex: backlog 3.6).
//
// CONVENTIONS GLOBALES (invariants AGENTS.md) :
// - IDs : UUIDv7. Générés côté application (paquet `uuidv7`, convention Phase 4)
//   ET filet de sécurité DB via @default(dbgenerated("uuidv7()")) — fonction
//   native PostgreSQL 18+. Si l'hébergement impose PG ≤ 17 : retirer les
//   @default et générer exclusivement côté app (aucun autre changement requis).
// - Argent : Int en CENTIMES de DZD (1 000 DA = 100 000). Jamais de float.
//   Plafond Int4 ≈ 21,4 M DA par montant unitaire — large pour le MVP ;
//   les agrégats (revenus) se calculent en bigint côté SQL.
// - Dates : UTC partout (@db.Timestamptz). Africa/Algiers = UTC+1 fixe (pas de
//   DST) → conversion locale stable, faite uniquement à l'affichage.
// - Tables/colonnes mappées en snake_case (@@map/@map) : indispensable pour la
//   migration SQL brute (contrainte d'exclusion) et le workflow admin DBeaver.
// - Devise unique DZD au MVP : `currency` n'apparaît que sur les mouvements
//   d'argent (Payment/Refund/Invoice), pas sur chaque table.
//
// CE QUE PRISMA NE PEUT PAS EXPRIMER (→ migration SQL brute jointe,
// `zwadj_constraints.sql`, à appliquer via `prisma migrate dev --create-only`) :
// - CREATE EXTENSION btree_gist
// - EXCLUDE USING gist anti-double-réservation (accepted/confirmed)
// - Index GiST de détection de chevauchements (demandes pending)
// - CHECKs : forme interne de service_pricings (exactement un mode par ligne),
//   bornes horaires des créneaux, commission 1–5 %, montants ≥ 0, note d'avis
//   1–5, etc. ⚠ EXCEPTION ASSUMÉE (Décision 2) : la correspondance
//   Service.pricingType ↔ contenu de ServicePricing/ServiceTier est une règle
//   APPLICATIVE (service layer + tests), pas une garantie BDD — voir Service.
// - Index uniques partiels : 1 paiement PAID par booking, 1 cashback actif
//   par booking.
//
// Prisma 7 : l'URL de connexion ne vit plus ici mais dans `prisma.config.ts`.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

// backlog 3.2 — "Role/permissions (or enum + policy table)" : au MVP, un enum
// suffit ; la matrice de permissions fine (5.2) vit en code, pas en base.
enum UserRole {
  CLIENT
  PRO
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  ANONYMIZED // Phase 14 : effacement loi 18-07 = anonymisation, pas suppression
}

/// Lot A10 / D37 — une suppression de compte est une DEMANDE, validée
/// manuellement par l'admin Zwadj. PENDING est le seul état réversible
/// (l'utilisateur peut annuler) — c'est ce qui rend D37 tenable.
enum AccountDeletionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum Locale {
  fr
  ar
}

// backlog 3.3 — publicationStatus: draft/pending/published
enum VenuePublicationStatus {
  DRAFT
  PENDING
  PUBLISHED
}

// D33 (Flux A, Lot A2) : visibilité pilotée par le PRO — libre-service,
// réversible, ORTHOGONALE à publicationStatus (modération one-way) et à
// deletedAt (fin de vie). Règles de lecture publique (A3) : liste = ACTIVE
// seul ; détail = ACTIVE + TEMPORARILY_UNAVAILABLE (bandeau) ; HIDDEN = 404.
enum VenueAvailabilityStatus {
  ACTIVE
  HIDDEN
  TEMPORARILY_UNAVAILABLE
}

// AGENTS.md "Modèle de réservation" — mode de la salle
enum BookingMode {
  SINGLE_SLOT // 1 réservation / jour : la réservation bloque la journée entière
  MULTI_SLOT  // plusieurs créneaux / jour : la réservation bloque son créneau
}

// backlog 3.6 — cycle de vie request-to-book (jamais d'instant-book)
enum BookingStatus {
  PENDING   // demande envoyée, ne bloque PAS le créneau
  ACCEPTED  // le pro a accepté → verrou BDD sur le créneau, en attente d'acompte
  DECLINED  // refusée par le pro
  EXPIRED   // pro sans réponse sous X jours, ou acompte non payé à temps
  CONFIRMED // acompte payé (en ligne) ou encaissement cash confirmé
  CANCELLED // annulée après acceptation/confirmation → libère le créneau
}

// backlog 3.6 — paymentMethod: online/cash (intention déclarée à la demande ;
// le choix final se fait à l'étape de paiement, cf. 9.7)
enum PaymentMethod {
  ONLINE
  CASH
}

// Distingue la demande client du walk-in créé par le pro (6.3 : le walk-in
// naît directement CONFIRMED, sans client inscrit)
enum BookingSource {
  CLIENT
  WALK_IN
}

// AGENTS.md — 4 types de tarification, pas de formule libre
enum ServicePricingType {
  FIXED
  PER_GUEST
  TIERED
  PER_UNIT
}

// backlog 3.4 — PricingRule (season, weekday, holiday) sur le prix de base salle
enum PricingRuleType {
  SEASON
  WEEKDAY
  HOLIDAY
}

// backlog 3.5 — visites auto-confirmées, annulables
enum VisitStatus {
  CONFIRMED
  CANCELLED
}

// Phase 7 — Chargily seul au MVP ; enum extensible (BaridiMob post-MVP)
enum PaymentProvider {
  CHARGILY
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELED
  EXPIRED
}

enum CommissionStatus {
  PENDING // calculée, en attente d'exigibilité
  DUE     // exigible auprès de la salle
  SETTLED // encaissée/soldée
  CANCELLED
}

// backlog 3.6 — CashbackClaim: pending_review/verified/paid/rejected
enum CashbackClaimStatus {
  PENDING_REVIEW
  VERIFIED
  PAID
  REJECTED
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationChannel {
  EMAIL // SMS différé post-MVP (assumptions backlog)
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

// =============================================================================
// IDENTITÉ & ACCÈS — backlog 3.2
// =============================================================================

// backlog 3.2 — User (email normalisé en minuscules côté app avant insertion)
model User {
  id           String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email        String     @unique // backlog 3.8 : index unique User.email
  passwordHash String?    @map("password_hash") // Lot 8 : null = compte créé via Google (jamais via register)
  role         UserRole   @default(CLIENT)
  locale       Locale     @default(fr)
  status       UserStatus @default(ACTIVE)
  firstName    String?    @map("first_name")
  lastName     String?    @map("last_name")
  phone        String? // normalisé E.164 +213 côté app (backlog 23.9 / libphonenumber)
  googleSub    String?    @unique @map("google_sub") // Lot 8 : claim `sub` du token Google (identité stable), unique quand présent

  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  proProfile              ProProfile?
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  bookings                Booking[]
  quotes                  Quote[]
  visitBookings           VisitBooking[]
  reviews                 Review[]
  favorites               Favorite[]
  notifications           Notification[]
  auditLogs               AuditLog[]               @relation("AuditActor")
  cashbackVerifications   CashbackClaim[]          @relation("CashbackVerifier")
  moderatedReviews        ReviewModeration[]       @relation("ReviewModerator")
  availabilityBlocks      AvailabilityBlock[]      @relation("BlockCreator")
  emailChangeTokens       EmailChangeToken[]
  deletionRequests        AccountDeletionRequest[] @relation("DeletionRequester")
  /// L'admin qui tranche est un User : Prisma exige les DEUX côtés de la
  /// relation, même quand un seul sens est interrogé.
  deletionDecisions       AccountDeletionRequest[] @relation("DeletionDecider")

  @@map("users")
}

// backlog 3.2 — "Session/RefreshToken" : le JWT d'accès est stateless, seul le
// refresh token est persisté (hashé). Une révocation = revokedAt renseigné.
model RefreshToken {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  /// Lot 7 (D27) — false = « se souvenir de moi » décoché : le cookie posé est
  /// un cookie de SESSION ; le flag est copié à chaque rotation pour que le
  /// serveur re-pose le même mode. La révocation globale l'IGNORE (voulu).
  persistent Boolean  @default(true)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// backlog 3.2 — EmailVerificationToken (usage unique, hashé)
model EmailVerificationToken {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// backlog 3.2 — PasswordResetToken (usage unique, hashé)
model PasswordResetToken {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Lot A10 — changement d'e-mail : l'ancienne adresse RESTE l'identifiant tant
/// que la nouvelle n'a pas été prouvée. Le lien part À LA NOUVELLE adresse ;
/// une faute de frappe ne peut donc pas verrouiller quelqu'un dehors.
/// Même mécanique que les deux tables de tokens ci-dessus (opaque 256 bits,
/// SHA-256 seul en base, usage unique, TTL) — `newEmail` est le seul ajout.
model EmailChangeToken {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  newEmail  String    @map("new_email")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_change_tokens")
}

/// D37 (A10) — un compte ne se supprime pas soi-même : il DEMANDE, et l'admin
/// Zwadj tranche. Un compte pro porte des commissions dues et un historique de
/// réservations qui doivent survivre : l'exécution est une anonymisation,
/// JAMAIS un DELETE SQL (même doctrine que `Venue.deletedAt`).
/// Une seule demande PENDING par compte, garantie EN BASE par un index unique
/// PARTIEL posé en SQL manuel dans la migration (patron commission_rate_bps).
model AccountDeletionRequest {
  id     String                @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId String                @map("user_id") @db.Uuid
  status AccountDeletionStatus @default(PENDING)
  reason String?
  /// SHA-256 de l'e-mail RÉELLEMENT détruit, posé À L'EXÉCUTION. Aucune PII en
  /// clair, mais une réclamation ultérieure depuis la même adresse reste
  /// vérifiable — sans lui, la promesse « vous pourrez récupérer vos salles »
  /// n'est pas outillée.
  emailHash    String?   @map("email_hash")
  requestedAt  DateTime  @default(now()) @map("requested_at") @db.Timestamptz(6)
  decidedAt    DateTime? @map("decided_at") @db.Timestamptz(6)
  decidedById  String?   @map("decided_by_id") @db.Uuid
  decisionNote String?   @map("decision_note")

  user      User                           @relation("DeletionRequester", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User?                          @relation("DeletionDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  archivedVenues AccountDeletionArchivedVenue[]

  @@index([userId])
  @@index([status, requestedAt])
  @@map("account_deletion_requests")
}

/// D41 — table FILLE, pas un tableau scalaire Postgres : le schéma n'en utilise
/// aucun, on ne crée pas ce précédent pour une trace, et la FK vers `Venue`
/// garantit qu'elle ne peut pas pendre dans le vide.
model AccountDeletionArchivedVenue {
  requestId  String   @map("request_id") @db.Uuid
  venueId    String   @map("venue_id") @db.Uuid
  archivedAt DateTime @default(now()) @map("archived_at") @db.Timestamptz(6)

  request AccountDeletionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  venue   Venue                  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@id([requestId, venueId])
  @@index([venueId])
  @@map("account_deletion_archived_venues")
}

// backlog 3.2 — ProProfile (lie l'utilisateur à son activité ; KYC = P1, les
// champs d'immatriculation restent optionnels au MVP)
model ProProfile {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  businessName       String   @map("business_name")
  phone              String // contact pro, normalisé +213
  /// D38 (A10) — seconde ligne, NULLABLE : beaucoup de salles opèrent avec
  /// deux numéros, mais un seul reste obligatoire.
  phone2             String?  @map("phone2")
  registrationNumber String?  @map("registration_number") // RC/NIF — KYC P1
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  venues Venue[]

  @@map("pro_profiles")
}

// =============================================================================
// GÉOGRAPHIE & SALLES — backlog 3.3
// =============================================================================

// backlog 3.3 — Wilaya (référentiel ; les 58 wilayas sont seedées, 3.8)
model Wilaya {
  id     String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  // Code officiel. Le seed (Lot A1) s'arrête VOLONTAIREMENT aux 58 wilayas
  // historiques : la loi n° 26-06 du 04/04/2026 en crée 11 de plus (codes
  // 59–69, Hauts Plateaux/Sud, transition administrative jusqu'au 31/12/2026)
  // SANS renuméroter les 58 existantes. Décision produit Ko datée du Lot A1,
  // pas un fait figé — élargir = de simples lignes de seed, zéro migration.
  code   Int    @unique
  nameFr String @map("name_fr")
  nameAr String @map("name_ar")

  cities City[]

  @@map("wilayas")
}

// backlog 3.3 — City (avec GPS, seedée avec les grandes villes)
model City {
  id       String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  wilayaId String   @map("wilaya_id") @db.Uuid
  nameFr   String   @map("name_fr")
  nameAr   String   @map("name_ar")
  lat      Decimal? @db.Decimal(9, 6) // coordonnées ≠ argent : Decimal exact autorisé
  lng      Decimal? @db.Decimal(9, 6)

  wilaya Wilaya  @relation(fields: [wilayaId], references: [id], onDelete: Restrict)
  venues Venue[]

  // Clé naturelle du seed (Lot A1, migration city_natural_key) : l'upsert
  // idempotent s'appuie dessus, et deux villes homonymes dans une même wilaya
  // deviennent impossibles EN BASE. Couvre wilayaId par préfixe gauche —
  // l'ancien @@index([wilayaId]) simple est retiré (redondant).
  @@unique([wilayaId, nameFr])
  @@map("cities")
}

// backlog 3.3 — Venue. Décisions AGENTS.md portées ici :
// - publicationStatus draft/pending/published (publication via endpoint admin, 6.1/12)
// - bookingMode single_slot/multi_slot
// - commissionRateBps : 1–5 % en POINTS DE BASE entiers (100–500), fixé par
//   l'admin Zwadj uniquement (jamais exposé au pro), snapshoté sur Commission.
//   (Le backlog dit "decimal" — points de base entiers retenus pour rester en
//   arithmétique entière de bout en bout, cf. invariant argent. 250 = 2,50 %.)
model Venue {
  id                String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerId           String                 @map("owner_id") @db.Uuid
  cityId            String                 @map("city_id") @db.Uuid
  slug              String                 @unique // SEO : /salle/{slug} — FIGÉ à la création (arbitrage Flux A : jamais modifié, pas de 301)
  nameFr            String                 @map("name_fr")
  nameAr            String                 @map("name_ar")
  taglineFr         String?                @map("tagline_fr")
  taglineAr         String?                @map("tagline_ar")
  descriptionFr     String?                @map("description_fr")
  descriptionAr     String?                @map("description_ar")
  districtFr        String?                @map("district_fr") // affiché sur les cartes (prototype)
  districtAr        String?                @map("district_ar")
  address           String?
  lat               Decimal?               @db.Decimal(9, 6) // pin-drop manuel (23.9), nullable en attendant
  lng               Decimal?               @db.Decimal(9, 6)
  // D36 (Lot A9) : capacity_min SUPPRIMÉE — donnée jamais remplie qui mentait
  // au filtre de recherche. capacityMax porte seule l'information utile
  // (« jusqu'à N invités »). CHECK SQL survivant : capacity_max > 0.
  capacityMax       Int                    @map("capacity_max")
  basePriceCents    Int                    @map("base_price_cents") // prix de base ; PricingRule le module par date
  bookingMode       BookingMode            @default(SINGLE_SLOT) @map("booking_mode")
  // D33 (Lot A2) : bascule libre-service du PRO, réversible — jamais touchée
  // par la modération. Colonne "status" (pas de @map nécessaire).
  status            VenueAvailabilityStatus @default(ACTIVE)
  publicationStatus VenuePublicationStatus @default(DRAFT) @map("publication_status")
  commissionRateBps Int                    @default(100) @map("commission_rate_bps") // CHECK SQL : 100–500
  // D35 (Lot A3) : % du prix de base (MÊME base que la commission), réglé par
  // l'admin SEUL. Défaut 0 = pas de cashback tant que non réglé (A3-③).
  // Garantie mécanique « jamais sur les fonds Zwadj » : CHECK SQL 0 ≤ x ≤ commission_rate_bps.
  cashbackRateBps   Int                    @default(0) @map("cashback_rate_bps")
  rejectionReason   String?                @map("rejection_reason") // Phase 12 : rejet admin → draft + raison
  // Soft delete (Lot A2) : fin de vie côté pro — JAMAIS de DELETE SQL sur
  // venues, l'historique réservations/commissions doit y survivre. Filtré
  // (IS NULL) par toutes les lectures pro et publiques.
  deletedAt         DateTime?              @map("deleted_at") @db.Timestamptz(6)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner              ProProfile          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  city               City                @relation(fields: [cityId], references: [id], onDelete: Restrict)
  photos             VenuePhoto[]
  photos360          VenuePhoto360[]
  photo360Links      VenuePhoto360Link[]
  amenities          VenueAmenity[]
  slotTemplates      SlotTemplate[]
  pricingRules       PricingRule[]
  services           Service[]
  availabilityBlocks AvailabilityBlock[]
  bookings           Booking[]
  quotes             Quote[]
  commissions        Commission[]
  visitAvailability  VisitAvailability[]
  visitBookings      VisitBooking[]
  reviews            Review[]
  favorites          Favorite[]
  /// D41 (A10) — trace des salles archivées PAR une suppression de compte.
  /// Sans elle, une restauration ne saurait pas distinguer ces salles de
  /// celles que le pro avait lui-même supprimées des mois plus tôt.
  deletionArchives   AccountDeletionArchivedVenue[]

  @@index([cityId])
  @@index([publicationStatus, cityId]) // recherche publique : published + ville
  @@index([ownerId])
  @@index([basePriceCents]) // filtre budget
  @@index([capacityMax]) // filtre capacité
  @@map("venues")
}

// Lot A4 — VenuePhoto : le pipeline A0 produit TOUJOURS { large, thumb } ; la
// base stocke les CLÉS du port MEDIA_STORAGE, jamais une URL figée — les URL
// publiques sont recalculées à la lecture via publicUrl(), donc l'adapter
// S3/CDN de prod changera les URL sans réécrire une seule ligne. width/height
// = dimensions du large (A8 : next/image, anti-CLS), déjà produites par le
// pipeline (coût nul). L'ordre d'affichage = sort_order ; règle A4 verrouillée :
// couverture publique = PREMIÈRE photo par sort_order.
model VenuePhoto {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  venueId    String   @map("venue_id") @db.Uuid
  storageKey String   @map("storage_key")
  thumbKey   String   @map("thumb_key")
  width      Int
  height     Int
  sortOrder  Int      @default(0) @map("sort_order")
  altFr      String?  @map("alt_fr")
  altAr      String?  @map("alt_ar")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, sortOrder])
  @@map("venue_photos")
}

// D34 (Lot A4, supersède l'ancienne contrainte « une seule photo ») — une
// ligne = UNE scène équirectangulaire du tour ; venue_id n'est plus @unique.
// thumb_key : bande de scènes de l'éditeur A6b — exposée sur le DTO PRO
// seulement, jamais dans Viewer360Data (payload public 1:1 Pannellum).
// Une contrainte UNIQUE (id, venue_id) est posée en SQL manuel : cible des FK
// composites des liaisons (renfort D34 n°1).
model VenuePhoto360 {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  venueId    String    @map("venue_id") @db.Uuid
  storageKey String    @map("storage_key")
  thumbKey   String    @map("thumb_key")
  capturedAt DateTime? @map("captured_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  venue  Venue               @relation(fields: [venueId], references: [id], onDelete: Cascade)
  linksA VenuePhoto360Link[] @relation("LinkPhotoA")
  linksB VenuePhoto360Link[] @relation("LinkPhotoB")

  @@index([venueId])
  @@map("venue_photos_360")
}

// D34 — une ligne = UNE liaison bidirectionnelle entre deux scènes de la MÊME
// salle, avec la position du hotspot propre à CHAQUE sens (yawA/pitchA sur la
// scène A, yawB/pitchB sur la scène B — les deux positions physiques
// diffèrent). Le graphe (boucle, chaîne…) n'est que l'ensemble des liaisons :
// rien n'est codé en dur, le <Viewer360 /> est strictement piloté par les
// données. Renforts en SQL manuel (patron commission_rate_bps) :
// 1. venue_id dénormalisé + FK COMPOSITES (photo_x_id, venue_id) →
//    (id, venue_id) : une liaison inter-salles est impossible EN BASE ;
// 2. CHECK photo_a_id <> photo_b_id (pas d'auto-liaison) ;
// 3. index unique LEAST/GREATEST : le doublon inversé (A,B)/(B,A) est refusé.
// Bornes yaw ∈ [-180,180] / pitch ∈ [-90,90] : CHECKs SQL + Zod partagé.
model VenuePhoto360Link {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  venueId   String   @map("venue_id") @db.Uuid
  photoAId  String   @map("photo_a_id") @db.Uuid
  photoBId  String   @map("photo_b_id") @db.Uuid
  yawA      Float    @map("yaw_a")
  pitchA    Float    @map("pitch_a")
  yawB      Float    @map("yaw_b")
  pitchB    Float    @map("pitch_b")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  venue  Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  photoA VenuePhoto360 @relation("LinkPhotoA", fields: [photoAId], references: [id], onDelete: Cascade)
  photoB VenuePhoto360 @relation("LinkPhotoB", fields: [photoBId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@index([photoAId])
  @@index([photoBId])
  @@map("venue_photo_360_links")
}

// backlog 3.3 — Amenity (référentiel seedé, 3.8) + jointure VenueAmenity
model Amenity {
  id     String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  key    String  @unique // ex: "parking", "piscine" — clé stable pour les icônes
  nameFr String  @map("name_fr")
  nameAr String  @map("name_ar")
  icon   String?

  venues VenueAmenity[]

  @@map("amenities")
}

// Jointure pure → PK composite (l'invariant UUIDv7 vise les entités, pas les
// tables de liaison sans identité propre)
model VenueAmenity {
  venueId   String @map("venue_id") @db.Uuid
  amenityId String @map("amenity_id") @db.Uuid

  venue   Venue   @relation(fields: [venueId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([venueId, amenityId])
  @@index([amenityId])
  @@map("venue_amenities")
}

// =============================================================================
// CRÉNEAUX, DISPONIBILITÉ & TARIFICATION — backlog 3.4
// =============================================================================

// backlog 3.4 / AGENTS.md — SlotTemplate : créneaux nommés, personnalisables
// dès le MVP (seedés avec 3 exemples standards, 3.8). Heures en MINUTES depuis
// minuit heure locale salle : startMinutes ∈ [0,1440), endMinutes ∈ (start,2880]
// — une valeur > 1440 = le créneau déborde sur le lendemain (soirée 20h→02h =
// 1200→1560). CHECKs en SQL. Ce choix rend le calcul de plage trivial et gère
// le passage de minuit sans ambiguïté.
model SlotTemplate {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  venueId      String   @map("venue_id") @db.Uuid
  nameFr       String   @map("name_fr")
  nameAr       String   @map("name_ar")
  startMinutes Int      @map("start_minutes")
  endMinutes   Int      @map("end_minutes")
  isActive     Boolean  @default(true) @map("is_active") // retrait sans casser l'historique
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  venue    Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  bookings Booking[]
  quotes   Quote[]

  @@index([venueId])
  @@map("slot_templates")
}

// backlog 3.4 "blocked ranges per venue" + 6.2 POST /availability/block —
// blocage manuel par le pro (travaux, événement familial…). Table séparée des
// bookings : une contrainte EXCLUDE ne traverse pas deux tables, donc le
// conflit bloc↔réservation est vérifié DANS la transaction d'acceptation
// (verrou SELECT … FOR UPDATE sur la ligne venue recommandé — même verrou pris
// à la création d'un bloc). Enjeu faible : les deux écritures viennent du même
// pro. Le conflit réservation↔réservation, lui, reste garanti par la BDD.
model AvailabilityBlock {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  venueId      String   @map("venue_id") @db.Uuid
  blockedFrom  DateTime @map("blocked_from") @db.Timestamptz(6)
  blockedUntil DateTime @map("blocked_until") @db.Timestamptz(6) // CHECK SQL : > blockedFrom
  reason       String?
  createdById  String?  @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  venue     Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  createdBy User? @relation("BlockCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([venueId, blockedFrom])
  @@map("availability_blocks")
}

// backlog 3.4 — PricingRule : multiplicateur sur le PRIX DE BASE SALLE
// uniquement (jamais sur les services). multiplierBps : 10000 = ×1,00 ;
// 12000 = ×1,20. Champs de portée selon ruleType (CHECKs SQL) :
//   SEASON  → startMonth/endMonth (1–12, chevauchement d'année autorisé :
//             start=11,end=2 = nov→fév)
//   WEEKDAY → daysOfWeek non vide (0=dimanche … 6=samedi)
//   HOLIDAY → aucun champ : s'applique quand la date ∈ table holidays
// En cas de règles multiples applicables : la plus haute `priority` gagne
// (pas de cumul) — à confirmer, cf. questions ouvertes.
model PricingRule {
  id            String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  venueId       String          @map("venue_id") @db.Uuid
  ruleType      PricingRuleType @map("rule_type")
  label         String? // libellé pro ("Haute saison été")
  multiplierBps Int             @map("multiplier_bps")
  startMonth    Int?            @map("start_month")
  endMonth      Int?            @map("end_month")
  daysOfWeek    Int[]           @map("days_of_week")
  priority      Int             @default(0)
  isActive      Boolean         @default(true) @map("is_active")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId])
  @@map("pricing_rules")
}

// backlog 3.4 — Holiday [P1] : jours fériés algériens. Fêtes religieuses =
// calendrier lunaire → chaque année est seedée avec ses dates concrètes
// (pas de récurrence calculée).
model Holiday {
  id     String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  date   DateTime @unique @db.Date
  nameFr String   @map("name_fr")
  nameAr String   @map("name_ar")

  @@map("holidays")
}

// =============================================================================
// PRESTATIONS — backlog 3.4 (Service, ServiceTier, ServicePricing)
// =============================================================================

// backlog 3.4 — Service : catalogue pur (identité, description, type de
// tarification). Les valeurs de prix vivent dans ServicePricing (3 types
// non-tiered) et ServiceTier (TIERED) — Décision 2, structure du backlog
// rétablie.
//
// ⚠ EXCEPTION ASSUMÉE AU PRINCIPE "GARANTI PAR LA BDD" (Décision 2, choix
// conscient — pas un oubli) : un CHECK PostgreSQL ne peut pas référencer une
// autre table, donc la correspondance entre `pricingType` et le contenu réel
// de ServicePricing/ServiceTier est une RÈGLE APPLICATIVE :
//   FIXED / PER_GUEST / PER_UNIT → exactement UNE ligne ServicePricing dont le
//                                  mode rempli correspond au pricingType,
//                                  et AUCUN ServiceTier
//   TIERED                       → AUCUNE ligne ServicePricing,
//                                  et ≥ 1 ServiceTier actif
// À valider dans le service layer (création 6.2 POST /services, édition PATCH,
// et surtout CHANGEMENT de pricingType : supprimer/créer la ligne de pricing
// ou les tiers dans la même transaction) + tests unitaires (Phase 15).
// Ce que la base garantit ENCORE : une ligne ServicePricing est toujours
// interne­ment cohérente (exactement un mode rempli, cf. CHECK SQL) et unique
// par service (serviceId @unique).
model Service {
  id            String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  venueId       String             @map("venue_id") @db.Uuid
  nameFr        String             @map("name_fr")
  nameAr        String             @map("name_ar")
  descriptionFr String?            @map("description_fr")
  descriptionAr String?            @map("description_ar")
  pricingType   ServicePricingType @map("pricing_type")
  isActive      Boolean            @default(true) @map("is_active")
  sortOrder     Int                @default(0) @map("sort_order")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  venue           Venue            @relation(fields: [venueId], references: [id], onDelete: Cascade)
  pricing         ServicePricing?
  tiers           ServiceTier[]
  bookingServices BookingService[]

  @@index([venueId])
  @@map("services")
}

// backlog 3.4 — ServicePricing (Décision 2) : les valeurs de prix des 3 types
// non-tiered, une ligne par service (serviceId @unique = 1-1 garanti par la
// base). Un service TIERED n'a PAS de ligne ici (ses prix = ServiceTier).
// Sémantique par mode (le CHECK SQL `service_pricings_shape` garantit qu'
// EXACTEMENT UN mode est rempli par ligne — ce qui reste vérifiable en base) :
//   fixedPriceCents    → prix forfaitaire (FIXED)
//   perGuestPriceCents → prix × nb d'invités du devis (PER_GUEST)
//   perUnitPriceCents  → prix × quantité choisie, avec unitNameFr/Ar
//                        obligatoires et bornes minUnits/maxUnits optionnelles
//                        du stepper client 9.6 (PER_UNIT)
// La correspondance avec Service.pricingType est applicative (cf. Service).
model ServicePricing {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serviceId          String   @unique @map("service_id") @db.Uuid
  fixedPriceCents    Int?     @map("fixed_price_cents")
  perGuestPriceCents Int?     @map("per_guest_price_cents")
  perUnitPriceCents  Int?     @map("per_unit_price_cents")
  unitNameFr         String?  @map("unit_name_fr") // ex: "table"
  unitNameAr         String?  @map("unit_name_ar")
  minUnits           Int?     @map("min_units")
  maxUnits           Int?     @map("max_units")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_pricings")
}

// backlog 3.4 — ServiceTier : paliers d'un service TIERED (standard/premium/
// luxe), prix FORFAITAIRE par palier (les 4 types sont purs — un "menu par
// invité à paliers" n'existe pas, cf. questions ouvertes).
model ServiceTier {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  serviceId  String   @map("service_id") @db.Uuid
  labelFr    String   @map("label_fr")
  labelAr    String   @map("label_ar")
  priceCents Int      @map("price_cents")
  sortOrder  Int      @default(0) @map("sort_order")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  service         Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  bookingServices BookingService[]

  @@index([serviceId])
  @@map("service_tiers")
}

// =============================================================================
// VISITES — backlog 3.5 (système ENTIÈREMENT séparé des réservations de fête :
// aucune FK vers SlotTemplate/Booking, aucune contrainte d'exclusion,
// auto-confirmation à la création — décision AGENTS.md)
// =============================================================================

// backlog 3.5 — VisitAvailability : fenêtres hebdomadaires dédiées aux visites
// (jour de semaine + plage horaire), indépendantes des SlotTemplate.
// dayOfWeek : 0=dimanche … 6=samedi. Minutes locales, pas de passage de minuit
// pour les visites (CHECK SQL : 0 ≤ start < end ≤ 1440).
model VisitAvailability {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  venueId      String   @map("venue_id") @db.Uuid
  dayOfWeek    Int      @map("day_of_week")
  startMinutes Int      @map("start_minutes")
  endMinutes   Int      @map("end_minutes")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@index([venueId, dayOfWeek])
  @@map("visit_availabilities")
}

// backlog 3.5 — VisitBooking : créée directement CONFIRMED (aucune approbation
// pro). Le pro est notifié (8.4) et peut annuler / contacter le client (6.4).
// Chevauchements tolérés par conception → pas de contrainte d'exclusion.
model VisitBooking {
  id          String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  venueId     String      @map("venue_id") @db.Uuid
  clientId    String      @map("client_id") @db.Uuid
  scheduledAt DateTime    @map("scheduled_at") @db.Timestamptz(6)
  status      VisitStatus @default(CONFIRMED)
  cancelledAt DateTime?   @map("cancelled_at") @db.Timestamptz(6)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  venue  Venue @relation(fields: [venueId], references: [id], onDelete: Restrict)
  client User  @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([venueId, scheduledAt])
  @@index([clientId])
  @@map("visit_bookings")
}

// =============================================================================
// DEVIS, RÉSERVATIONS, PAIEMENTS, COMMISSION, CASHBACK — backlog 3.6
// =============================================================================

// backlog 6.3 — Quote : snapshot de tarification AVANT la demande (POST /quotes
// puis POST /bookings). Fige le nombre d'invités (nécessaire aux PER_GUEST) et
// le détail des lignes dans `lines` (Json, montants en centimes entiers) — un
// snapshot d'affichage jamais requêté relationnellement ; les lignes
// OPÉRATIONNELLES vivent dans BookingService une fois la demande créée.
model Quote {
  id                 String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  venueId            String    @map("venue_id") @db.Uuid
  clientId           String?   @map("client_id") @db.Uuid
  slotTemplateId     String?   @map("slot_template_id") @db.Uuid
  eventDate          DateTime  @map("event_date") @db.Date
  guests             Int
  basePriceCents     Int       @map("base_price_cents") // prix salle résolu pour CETTE date (PricingRule appliquées)
  servicesTotalCents Int       @map("services_total_cents")
  totalCents         Int       @map("total_cents")
  depositCents       Int       @map("deposit_cents") // 30 % — la remise en ligne −1000 DA s'applique au PAIEMENT, pas ici
  lines              Json // [{serviceId, nameFr, nameAr, pricingType, unitPriceCents, quantity, tierId?, lineTotalCents}]
  validUntil         DateTime? @map("valid_until") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  venue        Venue         @relation(fields: [venueId], references: [id], onDelete: Restrict)
  client       User?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  slotTemplate SlotTemplate? @relation(fields: [slotTemplateId], references: [id], onDelete: SetNull)
  booking      Booking?

  @@index([venueId])
  @@index([clientId])
  @@map("quotes")
}

// backlog 3.4 "BookingRequest" + 3.6 "Booking" — UN SEUL modèle (Décision 3,
// acté — ne plus remettre en question) : la demande ET la réservation sont la
// même entité
// traversant la state machine pending → accepted → confirmed (6.3). Les
// endpoints (/bookings/:id/accept…) et l'écran "mes demandes" (9.7) traitent
// un seul objet sur tout le cycle ; la contrainte d'exclusion exige de toute
// façon accepted+confirmed dans UNE table.
//
// Plage bloquante : startsAt/endsAt (UTC), matérialisée À LA CRÉATION pour
// tous les statuts (la détection de chevauchement des pending en a besoin) :
//   MULTI_SLOT  → eventDate + heures du SlotTemplate (Africa/Algiers → UTC)
//   SINGLE_SLOT → journée locale entière [date 00:00, date+1 00:00) : c'est ce
//                 qui matérialise "1 réservation/jour"
// La contrainte EXCLUDE (SQL) ne s'applique qu'aux statuts ACCEPTED/CONFIRMED :
// les pending peuvent se chevaucher (décision AGENTS.md — la salle tranche).
// Le conflit des pending est CALCULÉ à la lecture via l'index GiST (pas de flag
// persisté → aucun risque d'obsolescence si l'accepté s'annule ensuite).
model Booking {
  id             String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  venueId        String        @map("venue_id") @db.Uuid
  clientId       String?       @map("client_id") @db.Uuid // NULL pour un walk-in (client non inscrit)
  quoteId        String?       @unique @map("quote_id") @db.Uuid // NULL pour un walk-in
  slotTemplateId String?       @map("slot_template_id") @db.Uuid // NULL si plage custom (walk-in)
  source         BookingSource @default(CLIENT)
  status         BookingStatus @default(PENDING)
  paymentMethod  PaymentMethod @default(ONLINE) @map("payment_method") // intention déclarée (9.6) ; le choix final se fait au paiement (9.7)

  eventDate  DateTime @map("event_date") @db.Date // date locale de l'événement (affichage/requêtes)
  startsAt   DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt     DateTime @map("ends_at") @db.Timestamptz(6) // CHECK SQL : > startsAt
  slotNameFr String?  @map("slot_name_fr") // snapshot du créneau (survit au renommage/suppression du template)
  slotNameAr String?  @map("slot_name_ar")

  guests             Int // CHECK SQL : > 0
  basePriceCents     Int @map("base_price_cents") // snapshots copiés du devis à la création
  servicesTotalCents Int @map("services_total_cents")
  totalCents         Int @map("total_cents")
  depositCents       Int @map("deposit_cents")

  // Contact figé à la demande (formulaire 9.6) / saisi par le pro (walk-in)
  contactFirstName String  @map("contact_first_name")
  contactLastName  String  @map("contact_last_name")
  contactPhone     String  @map("contact_phone") // +213 normalisé
  contactEmail     String? @map("contact_email")

  idempotencyKey String? @unique @map("idempotency_key") // invariant : POST /bookings idempotent

  // Jalons du cycle de vie (state machine 6.3 ; transitions gardées en code)
  expiresAt          DateTime? @map("expires_at") @db.Timestamptz(6) // pending → expired si pro muet (job pg-boss)
  acceptedAt         DateTime? @map("accepted_at") @db.Timestamptz(6)
  paymentDueAt       DateTime? @map("payment_due_at") @db.Timestamptz(6) // fenêtre d'acompte post-acceptation
  declinedAt         DateTime? @map("declined_at") @db.Timestamptz(6)
  declineReason      String?   @map("decline_reason")
  expiredAt          DateTime? @map("expired_at") @db.Timestamptz(6)
  confirmedAt        DateTime? @map("confirmed_at") @db.Timestamptz(6)
  cancelledAt        DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancellationReason String?   @map("cancellation_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  venue          Venue            @relation(fields: [venueId], references: [id], onDelete: Restrict)
  client         User?            @relation(fields: [clientId], references: [id], onDelete: SetNull) // anonymisation loi 18-07
  quote          Quote?           @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  slotTemplate   SlotTemplate?    @relation(fields: [slotTemplateId], references: [id], onDelete: SetNull)
  services       BookingService[]
  payments       Payment[]
  commission     Commission?
  cashbackClaims CashbackClaim[]
  invoices       Invoice[]
  review         Review?

  @@index([venueId, eventDate]) // backlog 3.8 : index composite
  @@index([venueId, status])
  @@index([clientId])
  @@index([status, expiresAt]) // job d'expiration pg-boss
  @@map("bookings")
}

// backlog 3.6 — BookingService : ligne de prestation SNAPSHOTÉE au moment du
// devis (les prix de Service/ServiceTier peuvent changer ensuite — décision
// 6.3). serviceId/tierId en SetNull : la ligne survit à la suppression du
// service, le snapshot fait foi. CHECK SQL : lineTotal = unitPrice × quantity.
// quantity : 1 (FIXED/TIERED), nb d'invités (PER_GUEST), nb d'unités (PER_UNIT).
model BookingService {
  id             String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  bookingId      String             @map("booking_id") @db.Uuid
  serviceId      String?            @map("service_id") @db.Uuid
  tierId         String?            @map("tier_id") @db.Uuid
  nameFr         String             @map("name_fr") // snapshots
  nameAr         String             @map("name_ar")
  pricingType    ServicePricingType @map("pricing_type")
  tierLabelFr    String?            @map("tier_label_fr")
  tierLabelAr    String?            @map("tier_label_ar")
  unitPriceCents Int                @map("unit_price_cents")
  quantity       Int
  lineTotalCents Int                @map("line_total_cents")

  booking Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  tier    ServiceTier? @relation(fields: [tierId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([serviceId])
  @@map("booking_services")
}

// backlog 3.6 / Phase 7 — Payment (Chargily seul au MVP). Plusieurs tentatives
// possibles par booking (échec → retry, 9.7) mais UN SEUL PAID par booking
// (index unique partiel en SQL). L'intention est persistée AVANT la redirection
// Chargily (Phase 7) pour qu'un webhook précoce trouve sa cible.
// discountAppliedCents : la remise −1000 DA (=100000 centimes) si paiement en
// ligne — appliquée ici, au moment du paiement, pas sur le devis.
model Payment {
  id                   String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  bookingId            String          @map("booking_id") @db.Uuid
  provider             PaymentProvider @default(CHARGILY)
  providerCheckoutId   String?         @map("provider_checkout_id") // id de session checkout Chargily
  providerPaymentId    String?         @map("provider_payment_id")
  amountCents          Int             @map("amount_cents") // montant réellement demandé (acompte − remise)
  discountAppliedCents Int             @default(0) @map("discount_applied_cents")
  currency             String          @default("DZD")
  status               PaymentStatus   @default(PENDING)
  failureReason        String?         @map("failure_reason")
  paidAt               DateTime?       @map("paid_at") @db.Timestamptz(6)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@index([bookingId])
  @@index([providerCheckoutId])
  @@map("payments")
}

// Phase 7 (impliqué par l'invariant AGENTS.md "webhook idempotent, dédup par
// event id") — journal des événements webhook reçus. @@unique(provider,eventId)
// EST le mécanisme de déduplication : un replay Chargily viole l'unicité et
// est ignoré proprement. Payload brut conservé pour rejeu/diagnostic.
model WebhookEvent {
  id              String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  provider        PaymentProvider @default(CHARGILY)
  eventId         String          @map("event_id")
  eventType       String?         @map("event_type")
  payload         Json
  receivedAt      DateTime        @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt     DateTime?       @map("processed_at") @db.Timestamptz(6)
  processingError String?         @map("processing_error")

  @@unique([provider, eventId])
  @@map("webhook_events")
}

// backlog 3.6 / Phase 7 — Commission : LE signal revenu/GMV du lancement (P0).
// rateBps = snapshot de Venue.commissionRateBps au moment de la réservation :
// un changement de taux ultérieur ne touche jamais les réservations passées
// (décision AGENTS.md).
//
// ASSIETTE (Décision 1) : baseAmountCents = LE PRIX DE BASE DE LA SALLE résolu
// à la date de l'événement (règles saison/weekday/holiday déjà appliquées),
// c'est-à-dire une COPIE de Booking.basePriceCents — JAMAIS Booking.totalCents
// ni le total des prestations. Pour l'agent qui codera l'endpoint Phase 7 :
//   baseAmountCents  = booking.basePriceCents
//   grossAmountCents = arrondi(baseAmountCents × rateBps / 10000)
// Cette assiette est celle du calcul break-even validé du cashback :
// 1 % × 100 000 DA (prix salle minimum) = 1 000 DA = déduction maximale.
//
// incentiveDeductionCents porte les 1000 DA de l'incitation anti-fuite (remise
// en ligne OU cashback cash vérifié) — toujours prélevés sur la commission due
// par la salle, jamais sur les fonds Zwadj. CHECKs SQL : rateBps 100–500,
// net = gross − deduction (net ≥ 0 grave le break-even en base).
model Commission {
  id                      String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  bookingId               String           @unique @map("booking_id") @db.Uuid
  venueId                 String           @map("venue_id") @db.Uuid
  rateBps                 Int              @map("rate_bps")
  baseAmountCents         Int              @map("base_amount_cents") // = Booking.basePriceCents (prix salle résolu à la date — Décision 1, jamais le total)
  grossAmountCents        Int              @map("gross_amount_cents") // arrondi(base × rateBps / 10000)
  incentiveDeductionCents Int              @default(0) @map("incentive_deduction_cents")
  netAmountCents          Int              @map("net_amount_cents")
  status                  CommissionStatus @default(PENDING)
  settledAt               DateTime?        @map("settled_at") @db.Timestamptz(6)
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  venue   Venue   @relation(fields: [venueId], references: [id], onDelete: Restrict)

  @@index([venueId, status])
  @@map("commissions")
}

// backlog 3.6 / 6.5 — CashbackClaim : remboursement 1000 DA après paiement
// CASH + reçu, vérifié avec la salle avant paiement. INVARIANT AGENTS.md :
// toujours lié à un Booking existant (FK NOT NULL obligatoire — jamais de
// claim orphelin). Un seul claim ACTIF par booking (index unique partiel SQL
// sur PENDING_REVIEW/VERIFIED/PAID) ; une re-soumission après REJECTED reste
// possible.
model CashbackClaim {
  id                   String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  bookingId            String              @map("booking_id") @db.Uuid
  receiptUrl           String              @map("receipt_url")
  amountCents          Int                 @default(100000) @map("amount_cents") // 1000 DA
  status               CashbackClaimStatus @default(PENDING_REVIEW)
  verifiedWithVenueAt  DateTime?           @map("verified_with_venue_at") @db.Timestamptz(6)
  verifiedById         String?             @map("verified_by_id") @db.Uuid // admin Zwadj (6.5)
  paidAt               DateTime?           @map("paid_at") @db.Timestamptz(6)
  rejectionReason      String?             @map("rejection_reason")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  verifiedBy User?   @relation("CashbackVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([status])
  @@map("cashback_claims")
}

// backlog 3.6 — Invoice/Receipt [P1]. `number` unique ; la numérotation
// SÉQUENTIELLE SANS TROU (exigence légale DZ, backlog 23.5) s'implémente à la
// génération via un compteur transactionnel — pas ici (concerne la Phase 7 P1).
model Invoice {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  bookingId   String   @map("booking_id") @db.Uuid
  number      String   @unique
  amountCents Int      @map("amount_cents")
  currency    String   @default("DZD")
  pdfUrl      String?  @map("pdf_url")
  issuedAt    DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@map("invoices")
}

// backlog 3.6 — Refund [P1] : remboursement d'un Payment via Chargily (Phase 7 P1)
model Refund {
  id                String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  paymentId         String       @map("payment_id") @db.Uuid
  amountCents       Int          @map("amount_cents")
  status            RefundStatus @default(PENDING)
  reason            String?
  providerRefundId  String?      @map("provider_refund_id")
  processedAt       DateTime?    @map("processed_at") @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@map("refunds")
}

// =============================================================================
// ENGAGEMENT & OPS — backlog 3.7
// =============================================================================

// backlog 3.7 — Review [P1] : lié à une réservation passée (PRD US8) →
// bookingId @unique = 1 avis par réservation, et impossible sans réservation.
model Review {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  bookingId String   @unique @map("booking_id") @db.Uuid
  venueId   String   @map("venue_id") @db.Uuid // dénormalisé pour lister par salle
  clientId  String?  @map("client_id") @db.Uuid
  rating    Int // CHECK SQL : 1–5
  comment   String?
  locale    Locale   @default(fr)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  booking    Booking           @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  venue      Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  client     User?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  moderation ReviewModeration?

  @@index([venueId])
  @@map("reviews")
}

// backlog 3.7 — ReviewModeration [P1] : workflow de modération séparé de
// l'UGC (publication seulement si APPROVED — PRD US8).
model ReviewModeration {
  id            String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  reviewId      String           @unique @map("review_id") @db.Uuid
  status        ModerationStatus @default(PENDING)
  moderatedById String?          @map("moderated_by_id") @db.Uuid
  moderatedAt   DateTime?        @map("moderated_at") @db.Timestamptz(6)
  reason        String?

  review      Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  moderatedBy User?  @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)

  @@map("review_moderations")
}

// backlog 3.7 — Favorite [P2 : UI différée, schéma prêt — demandé au brief]
model Favorite {
  clientId  String   @map("client_id") @db.Uuid
  venueId   String   @map("venue_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  client User  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  venue  Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@id([clientId, venueId])
  @@index([venueId])
  @@map("favorites")
}

// backlog 3.7 — Notification [P1] : journal des notifications sorties (email
// seul au MVP). Le centre in-app et NotificationPreference sont différés
// post-MVP (Phase 8) — modèle volontairement minimal.
model Notification {
  id        String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  channel   NotificationChannel @default(EMAIL)
  type      String // ex: "booking.accepted", "cashback.paid" (taxonomie Phase 8)
  payload   Json?
  status    NotificationStatus  @default(QUEUED)
  sentAt    DateTime?           @map("sent_at") @db.Timestamptz(6)
  error     String?
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

// backlog 3.7 — AuditLog [P1] : traçabilité des actions sensibles (Phase 13) —
// publication de salle, changement de taux de commission, vérification
// cashback, transitions de réservation…
model AuditLog {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  String?  @map("actor_role")
  action     String // ex: "venue.publish", "commission_rate.update"
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

