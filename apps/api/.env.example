# ── Base de données (PostgreSQL 18, cf. docker-compose racine) ──────────────
DATABASE_URL=postgresql://zwadj:zwadj@localhost:5432/zwadj?schema=public

# ── API ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# Origines autorisées (client Next + Pro Vite), séparées par des virgules
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Auth (Lot 0) ─────────────────────────────────────────────────────────────
# Secret HS256 du JWT d'accès (≥ 32 caractères).
# EN PROD : générer avec `openssl rand -base64 48` — ne JAMAIS garder celui-ci.
JWT_ACCESS_SECRET=dev-only-secret-change-me-in-production-0123456789
# Durée de vie de l'access token (900s / 15m / 1h)
JWT_ACCESS_TTL=15m
# Durée de vie du refresh token (jours) — persisté hashé en base, rotation à chaque refresh
REFRESH_TOKEN_TTL_DAYS=30
# URLs publiques des fronts (liens des emails de vérification / reset)
CLIENT_URL=http://localhost:3000
PRO_URL=http://localhost:5173
# Cookie refresh : Secure=true derrière HTTPS (prod)
AUTH_COOKIE_SECURE=false
# Expéditeur affiché par la primitive email (adaptateur dev = log console)
EMAIL_FROM=Zwadj <no-reply@zwadj.dz>

# ── Chargily (PLACEHOLDER — décision validée : aucune intégration au squelette,
#    module de paiement = tranche Phase 7 du backlog) ─────────────────────────
# CHARGILY_API_KEY=
# CHARGILY_SECRET_KEY=
# CHARGILY_WEBHOOK_SECRET=

# ── OAuth Google (Lot 8) ──────────────────────────────────────────────────────
# Client ID « Web » du projet Google Cloud (console → APIs & Services →
# Credentials → OAuth 2.0 Client ID, type Web application). Sert d'AUDIENCE de
# vérification des ID tokens GIS côté API. ABSENTE : l'API boote normalement et
# POST /auth/google répond 503 GOOGLE_AUTH_DISABLED. EXIGÉE en production.
# GOOGLE_CLIENT_ID=

# ── Paiement (Phase 7, lot E3a) ───────────────────────────────────────────────
# Drapeau maître du chemin de l'argent. Éteint, aucune route de paiement n'est
# exposée et aucun webhook n'est accepté. Il existe AVANT la moindre ligne de
# paiement : E3b→E3e se livrent l'un après l'autre, et sans lui chaque livraison
# intermédiaire exposerait une moitié de chemin de règlement en production.
# ⚠ DÉFAUT « false », et c'est une décision de sécurité : un drapeau de paiement
# dont l'absence vaudrait « activé » s'allumerait tout seul au premier
# déploiement où la variable manque.
# ⚠ EXIGÉE EXPLICITEMENT EN PRODUCTION malgré ce défaut — l'oublier fait refuser
# le boot. Le défaut protège de l'allumage accidentel ; l'exigence protège de
# l'inverse : croire les paiements actifs alors que la variable a été oubliée.
# Seules « true » et « 1 » allument. « oui », « yes », « on », « TRUE » : éteint.
PAYMENTS_ENABLED=false

