# ── Base de données (PostgreSQL 18, cf. docker-compose racine) ──────────────
DATABASE_URL=postgresql://zwadj:zwadj@localhost:5432/zwadj?schema=public

# ── API ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# Origines autorisées (client Next + Pro Vite), séparées par des virgules
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Auth (Lot 0) ─────────────────────────────────────────────────────────────
# Secret HS256 du JWT d'accès (≥ 32 caractères).
# EN PROD : générer avec `openssl rand -base64 48` — ne JAMAIS garder celui-ci.
JWT_ACCESS_SECRET=dev-only-secret-change-me-in-production-0123456789
# Durée de vie de l'access token (900s / 15m / 1h)
JWT_ACCESS_TTL=15m
# Durée de vie du refresh token (jours) — persisté hashé en base, rotation à chaque refresh
REFRESH_TOKEN_TTL_DAYS=30
# URLs publiques des fronts (liens des emails de vérification / reset)
CLIENT_URL=http://localhost:3000
PRO_URL=http://localhost:5173
# Cookie refresh : Secure=true derrière HTTPS (prod)
AUTH_COOKIE_SECURE=false
# Expéditeur affiché par la primitive email (adaptateur dev = log console)
EMAIL_FROM=Zwadj <no-reply@zwadj.dz>

# ── OAuth Google (Lot 8) ──────────────────────────────────────────────────────
# Client ID « Web » du projet Google Cloud (console → APIs & Services →
# Credentials → OAuth 2.0 Client ID, type Web application). Sert d'AUDIENCE de
# vérification des ID tokens GIS côté API. ABSENTE : l'API boote normalement et
# POST /auth/google répond 503 GOOGLE_AUTH_DISABLED. EXIGÉE en production.
# GOOGLE_CLIENT_ID=

# ── Paiement (Phase 7, lot E3a) ───────────────────────────────────────────────
# Drapeau maître du chemin de l'argent. Éteint, aucune route de paiement n'est
# exposée et aucun webhook n'est accepté. Il existe AVANT la moindre ligne de
# paiement : E3b→E3e se livrent l'un après l'autre, et sans lui chaque livraison
# intermédiaire exposerait une moitié de chemin de règlement en production.
# ⚠ DÉFAUT « false », et c'est une décision de sécurité : un drapeau de paiement
# dont l'absence vaudrait « activé » s'allumerait tout seul au premier
# déploiement où la variable manque.
# ⚠ EXIGÉE EXPLICITEMENT EN PRODUCTION malgré ce défaut — l'oublier fait refuser
# le boot. Le défaut protège de l'allumage accidentel ; l'exigence protège de
# l'inverse : croire les paiements actifs alors que la variable a été oubliée.
# Seules « true » et « 1 » allument. « oui », « yes », « on », « TRUE » : éteint.
PAYMENTS_ENABLED=false

# ── Chargily (Phase 7, lot E3b) ───────────────────────────────────────────────
# ⚠ CE FICHIER EST SUIVI PAR GIT. `.gitignore` ne couvre que `.env` — pas
# `.env.example`. AUCUNE valeur réelle ne s'écrit ici : ni clé, ni jeton, ni
# identifiant. Les vraies valeurs vont dans `.env`, jamais versionné.
#
# ⚠ Les deux variables ci-dessous sont OBLIGATOIRES dès que PAYMENTS_ENABLED
# vaut « true » : sans elles, l'API REFUSE DE BOOTER, en nommant la manquante.
# C'est délibéré — allumer les paiements sans fournisseur faisait croire le
# règlement ouvert pendant que chaque tentative rendait 503, sans rien dire au
# démarrage. Éteintes, elles ne sont exigées nulle part : un poste de dev sans
# compte Chargily reste pleinement fonctionnel.
#
# ⚠ CHARGILY_BASE_URL n'a AUCUN DÉFAUT, et c'est le point. Seule la base de TEST
# a été observée en bac à sable ; celle de production se relève du tableau de
# bord, elle ne se déduit pas de l'autre. Un défaut pointant le test ferait
# qu'une production mal configurée encaisserait dans le vide : des sessions qui
# s'ouvrent, un parcours qui semble marcher, et aucun dinar.
# Base observée en mode test : https://pay.chargily.net/test/api/v2
# CHARGILY_BASE_URL=
#
# Clé SECRÈTE du marchand (tableau de bord Chargily). Elle n'apparaît que dans
# l'en-tête Authorization construit par `chargily.gateway.ts` — jamais
# journalisée, jamais renvoyée par une route.
# CHARGILY_SECRET_KEY=
#
# Délai d'attente de l'appel sortant, en millisecondes. Défaut 10000, bornes
# 1000–60000. ⚠ Trop court, on abandonne des sessions que Chargily a réellement
# créées ; trop long, un fournisseur lent retient nos requêtes entrantes.
# CHARGILY_TIMEOUT_MS=10000

# ── Flux A (Lot A0) — stockage média ─────────────────────────────────────────
# Racine DISQUE des médias, résolue relativement au cwd de l'API.
MEDIA_DISK_ROOT=var/media
